# Istanbul Transit Navigator Environment Configuration
PORT=8000
DEBUG=false

# OpenTripPlanner GraphQL Endpoint
OTP_GRAPHQL_URL=http://localhost:8080/otp/routers/default/index/graphql

# İETT Real-time Fleet Web Service
IETT_API_URL=https://api.ibb.gov.tr/iett/FiloDurum/SeferGerceklesme.asmx?wsdl

# Geocoding & OpenStreetMap User-Agent
USER_AGENT=IstanbulTransitCore/3.0 (contact: info@transit-navigator.local)

# CORS Allowed Origins (comma-separated, default: *)
CORS_ORIGINS=*
